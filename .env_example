# Copy this file to .env only if you do not already have a configured .env.
# Replace this placeholder with your own Gemini API key. Never commit .env.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional overrides; uncomment only when you want to change the app defaults.
# GEMINI_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=768
# MAX_TOOL_CALLS=24

# Host database port used by compose.dev.yaml.
# POSTGRES_HOST_PORT=55432

# Docker Compose sets DATABASE_URL and RUNTIME_DIR inside the app container.
# For a separately configured local database, set your own connection details:
# DATABASE_URL=postgresql://replace_user:replace_password@localhost:55432/replace_database
